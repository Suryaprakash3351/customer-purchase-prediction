  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "df['Age_Group'] = pd.cut(df['Age'], bins=[17,25,35,45,55,70],\n",
    "                          labels=['18-25','26-35','36-45','46-55','56-70'])\n",
    "\n",
    "df['Spend_Band'] = pd.cut(df['Total_Spend'], bins=[-1,1000,2500,4000,100000],\n",
    "                           labels=['Low','Medium','High','Very High'])\n",
    "\n",
    "df['Engagement_Level'] = pd.cut(df['Engagement_Score'], bins=[-1,33,66,100],\n",
    "                                 labels=['Low','Medium','High'])\n",
    "\n",
    "df['Frequent_Buyer'] = df['Purchase_Frequency'].apply(lambda x: 'Yes' if x >= 4 else 'No')\n",
    "\n",
    "df[['Age','Age_Group','Total_Spend','Spend_Band','Engagement_Score','Engagement_Level']].head()"
   ]
