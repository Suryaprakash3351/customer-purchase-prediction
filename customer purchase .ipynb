    "## 9. Statistical Thinking\n",
    "\n",
    "Mean, median, std dev for the important numeric columns, plus checking for outliers using IQR."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [],
   "source": [
    "num_cols = ['Age','Annual_Income','Engagement_Score','Avg_Session_Minutes',\n",
    "            'Purchase_Frequency','Total_Spend']\n",
    "df[num_cols].agg(['mean','median','std','min','max']).T.round(2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Total_Spend outliers: 8\n",
      "Annual_Income outliers: 12\n",
      "\n",
      "Outliers can pull the mean/std around and affect the model, so keeping them in mind but not removing them since they look like real high-spending customers, not data entry mistakes.\n"
     ]
    }
   ],
   "source": [
    "def iqr_outliers(series):\n",
    "    q1 = series.quantile(0.25)\n",
    "    q3 = series.quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    lower = q1 - 1.5 * iqr\n",
    "    upper = q3 + 1.5 * iqr\n",
    "    return series[(series < lower) | (series > upper)]\n",
    "\n",
    "spend_outliers = iqr_outliers(df['Total_Spend'])\n",
    "income_outliers = iqr_outliers(df['Annual_Income'])\n",
    "\n",
    "print('Total_Spend outliers:', len(spend_outliers))\n",
    "print('Annual_Income outliers:', len(income_outliers))\n",
    "print('\\nOutliers can pull the mean/std around and affect the model, so keeping them in '\n",
    "      'mind but not removing them since they look like real high-spending customers, not '\n",
    "      'data entry mistakes.')"
   ]
  },
